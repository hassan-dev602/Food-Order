# =========================================================
# Professional Project .gitignore
# Backend: Python / Django
# Frontend: React / Vite / Node.js
# =========================================================

# ---------------------------------------------------------
# Environment variables and secrets
# ---------------------------------------------------------
.env
.env.*
!.env.example
*.env

# ---------------------------------------------------------
# Python / Django backend
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
venv/
ENV/
env/
.venv/

# Django files
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# ---------------------------------------------------------
# Node.js / React / Vite frontend
# ---------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.old

# Build output
dist/
build/
.vite/
.cache/
.parcel-cache/

# Frontend environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# ---------------------------------------------------------
# Dependency/cache folders
# ---------------------------------------------------------
.cache/
*.tsbuildinfo
.eslintcache

# ---------------------------------------------------------
# IDE / editor files
# ---------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ---------------------------------------------------------
# Operating system files
# ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------
# Temporary / backup / archive files
# ---------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.swp
*.zip
*.rar
*.7z

# ---------------------------------------------------------
# Logs
# ---------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------
# Uploaded project archives
# ---------------------------------------------------------
backend*.zip
frontend*.zip
